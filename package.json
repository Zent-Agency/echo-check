{
  "name": "echocheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start",
    "test": "node --test lib/echo/*.test.ts",
    "record": "node --env-file-if-exists=.env --env-file-if-exists=.env.local agents/record.ts",
    "og": "esbuild scripts/generate-og.tsx --bundle --platform=node --format=esm --jsx=automatic --external:next --external:react --outfile=.og-build.mjs && node .og-build.mjs && rm -f .og-build.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "next": "^15.5.21",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.4",
    "wrangler": "^4.86.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "22.7.4",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "typescript": "5.6.3"
  }
}
